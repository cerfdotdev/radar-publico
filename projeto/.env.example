# Copie para .env e troque os valores fora do ambiente de desenvolvimento.
POSTGRES_DB=radar
POSTGRES_USER=radar
POSTGRES_PASSWORD=radar

# Usuário só leitura usado pela API
POSTGRES_API_USER=radar_api
POSTGRES_API_PASSWORD=radar_api

# Timeout das consultas do usuário radar_api, aplicado só na criação do banco.
# Vazio usa o padrão de db/init/05-usuario-api.sh.
POSTGRES_API_STATEMENT_TIMEOUT=

# Limites do backend. Vazio usa o padrão do código; valores e como ajustar no
# README, seção "Limites e ajuste por máquina".
GUNICORN_WORKERS=
GUNICORN_THREADS=
GUNICORN_TIMEOUT=
DB_POOL_MAX=
DB_POOL_TIMEOUT_S=
DB_STATEMENT_TIMEOUT_S=
RATE_LIMIT_REQUESTS=
RATE_LIMIT_SIMILAR_REQUESTS=
RATE_LIMIT_WINDOW_S=
PROXY_HOPS=

# Segundos que o navegador e o nginx do frontend reusam uma busca (README, "Cache").
# Vazio usa o padrão; 0 desliga o cache no backend e no nginx (ex.: teste de carga sem cache).
API_CACHE_TTL_S=

# Endereço em que a porta 5000 da API é publicada. Vazio = 127.0.0.1 (só esta
# máquina). 0.0.0.0 abre para a rede, mas quem chamar a 5000 direto pode
# escapar do limite por IP mandando um X-Forwarded-For falso.
API_BIND_ADDRESS=
# Porta da API no servidor (o container sempre escuta na 5000). Vazio = 5000.
API_PORT=

# Endereço e porta em que o site (nginx do frontend) é publicado. Vazio = 0.0.0.0 e 8080.
# Atrás de outro proxy, como o Traefik do Dokploy (docs/deploy.md), use 127.0.0.1 e
# uma porta livre.
WEB_BIND_ADDRESS=
WEB_PORT=

# Faixa de IPs do proxy na frente do nginx cujo X-Forwarded-For vale como IP do
# cliente (ex.: 10.0.0.0/8 no Dokploy). Vazio = só a própria máquina, sem proxy.
NGINX_PROXY_CONFIAVEL=

# Limites da borda (nginx do frontend), antes do cache e do Gunicorn. Vazio usa o padrão de
# frontend/limites-borda.envsh; valores e como ajustar no README, "Limites da borda".
# Por IP em /api/: requisições por segundo, rajada e simultâneas. NGINX_LIMITE_IP=0 desliga
# os três (ex.: teste de carga, em que todos os clientes saem do mesmo IP).
NGINX_LIMITE_IP=
NGINX_LIMITE_IP_POR_S=
NGINX_LIMITE_IP_RAJADA=
NGINX_LIMITE_IP_SIMULTANEAS=
# Requisições ao mesmo tempo no Gunicorn; acima disso, 503 na hora. Ao mudar
# GUNICORN_WORKERS ou GUNICORN_THREADS, use 2 × workers × threads. NGINX_LIMITE_BACKEND=0 desliga.
NGINX_LIMITE_BACKEND=
NGINX_LIMITE_BACKEND_SIMULTANEAS=

# Teto de memória, CPU e processos de cada container (o servidor é dividido com outros
# serviços). Vazio usa o padrão do docker-compose.yml: 2g/2/128 no banco, 512m/2/64 no
# backend e 128m/1/32 no frontend.
DB_SERVER_MEM_LIMIT=
DB_SERVER_CPUS=
DB_SERVER_PIDS_LIMIT=
BACKEND_MEM_LIMIT=
BACKEND_CPUS=
BACKEND_PIDS_LIMIT=
FRONTEND_MEM_LIMIT=
FRONTEND_CPUS=
FRONTEND_PIDS_LIMIT=
# Rotação do log do Docker de cada container. Vazio = 3 arquivos de 10m.
LOG_MAX_SIZE=
LOG_MAX_FILE=
