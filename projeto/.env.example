# Copie para .env e troque os valores fora do ambiente de desenvolvimento.
POSTGRES_DB=radar
POSTGRES_USER=radar
POSTGRES_PASSWORD=radar

# Usuário só leitura usado pela API
POSTGRES_API_USER=radar_api
POSTGRES_API_PASSWORD=radar_api

# Timeout das consultas do usuário radar_api, aplicado só na criação do banco.
# Vazio usa o padrão de db/init/05-usuario-api.sh.
POSTGRES_API_STATEMENT_TIMEOUT=

# Limites do backend. Vazio usa o padrão do código; valores e como ajustar no
# README, seção "Limites e ajuste por máquina".
GUNICORN_WORKERS=
GUNICORN_THREADS=
GUNICORN_TIMEOUT=
DB_POOL_MAX=
DB_POOL_TIMEOUT_S=
DB_STATEMENT_TIMEOUT_S=
RATE_LIMIT_REQUESTS=
RATE_LIMIT_WINDOW_S=
PROXY_HOPS=

# Segundos que o navegador e o nginx do frontend reusam uma busca (README, "Cache").
# Vazio usa o padrão; 0 desliga o cache no backend e no nginx (ex.: teste de carga sem cache).
API_CACHE_TTL_S=

# Endereço em que a porta 5000 da API é publicada. Vazio = 127.0.0.1 (só esta
# máquina). 0.0.0.0 abre para a rede, mas quem chamar a 5000 direto pode
# escapar do limite por IP mandando um X-Forwarded-For falso.
API_BIND_ADDRESS=
